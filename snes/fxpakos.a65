.text
.link page $c0
#include "memmap.i65"

; Static banner in the real BG2 buffer ($7e, not loprint's $7f port bank).
; Called from setup_gfx with NMI disabled. Never call shared text renderers
; from NMI: they modify the foreground print parameters and WRAM port.
fxos_init_chrome:
  php
  rep #$30 : .al : .xl
  ldx #$0000
  ldy #$0000
- lda @fxos_nav_text,y
  and #$00ff
  beq +
  ora #$2000
  sta @BG2_TILE_BUF+64+2,x
  inx
  inx
  iny
  bra -
+ plp
  rts

fxos_nav_text
  .byt "FXPAK OS  SNES  FAV  REC  SET", 0
