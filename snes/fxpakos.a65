.text
.link page $c0
#include "memmap.i65"
#include "dma.i65"

; Static banner in the real BG2 buffer ($7e, not loprint's $7f port bank).
; Called from setup_gfx with NMI disabled. Never call shared text renderers
; from NMI: they modify the foreground print parameters and WRAM port.
fxos_init_chrome:
  php
; BG2 palette 7 in the Mode 3 header only; Mode 5 text palettes stay intact.
  sep #$20 : .as
  lda #112
  sta $2121
  DMA7(#$00, #8, #^fxos_chrome_palette, #!fxos_chrome_palette, #$22)
  phb
  sep #$20 : .as
  lda #$7e
  pha
  plb
  rep #$30 : .al : .xl
  ldx #0
  ldy #0
fxos_brand_loop:
  lda @fxos_brand_text,x
  and #$00ff
  beq fxos_collection_start
  ora #$2000
  sta !BG2_TILE_BUF+64+4,y
  inx
  iny
  iny
  bra fxos_brand_loop
fxos_collection_start:
  ldx #0
  ldy #0
fxos_collection_loop:
  lda @fxos_collection_text,x
  and #$00ff
  beq fxos_nav_start
  ora #$2000
  sta !BG2_TILE_BUF+3*64+4,y
  inx
  iny
  iny
  bra fxos_collection_loop
fxos_nav_start:
  ldx #0
  ldy #0
fxos_nav_loop:
  lda @fxos_nav_text,x
  and #$00ff
  beq fxos_border_start
  ora #$3c00
  sta !BG2_TILE_BUF+5*64+4,y
  inx
  iny
  iny
  bra fxos_nav_loop
fxos_border_start:
  ldy #4
  lda #$3c2d
fxos_border_loop:
  sta !BG2_TILE_BUF+6*64,y
  iny
  iny
  cpy #60
  bcc fxos_border_loop
  plb
  plp
  rts

fxos_chrome_palette .word 0,$6e97,$30ea,$5152
fxos_brand_text .byt "FXPAK OS",0
fxos_collection_text .byt "SUPER NINTENDO COLLECTION",0
fxos_nav_text .byt "LIBRARY   FAVORITES   RECENT",0

; Called only during forced blank by setup_gfx. Keep the stock fonts,
; background modes and tilemap allocation. OBJ uses byte VRAM $c800-$e3ff,
; palette 0 ($80-$8f), OAM entries 32..66. Existing theme assets stay bundled.
fxos_init_cover:
  php
  sep #$20 : .as
  rep #$10 : .xl
  lda #$02
  sta fxos_cover_visible ; force an OAM refresh on the first NMI
  ldx #$6400
  stx $2116
  DMA7(#$01, #$1c00, #^fxos_cover_tiles, #!fxos_cover_tiles, #$18)
  lda #$80
  sta $2121
  DMA7(#$00, #32, #^fxos_cover_palette, #!fxos_cover_palette, #$22)
; Retire the default logo/banner in this dashboard, without changing its data.
  ldx #BG1_TILE_BASE
  stx $2116
  DMA7(#$09, #64*7, #^zero, #!zero, #$18)
; Hide default decorative sprites and unused OAM slots.
  ldx #$0000
  stx $2102
  ldx #128
- stz $2104
  lda #240
  sta $2104
  stz $2104
  stz $2104
  dex
  bne -
; Set 16x16 size flags for the 35 reserved sprites.
  ldx #$0104
  stx $2102
  DMA7(#$00, #9, #^fxos_cover_oam_high, #!fxos_cover_oam_high, #$04)
  plp
  rts

; Called by stock NMI with DB=0. Transfer only on visibility changes.
; No shared text state, WRAM port accesses, or artwork DMA during active video.
fxos_nmi_cover:
  php
  rep #$30 : .al : .xl
  lda window_stack_head
  cmp #$ffff
  bne fxos_hide_cover
  lda screen_dma_disable
  bne fxos_hide_cover
  sep #$20 : .as
  lda fxart_source
  inc
  cmp fxos_cover_visible
  beq fxos_cover_done
  sta fxos_cover_visible
  ldx #$0040 ; OAM word address of entry 32
  stx $2102
  lda fxart_source
  beq +
  DMA7(#$00, #140, #^fxart_dynamic_oam, #!fxart_dynamic_oam, #$04)
  bra fxos_cover_done
+ DMA7(#$00, #140, #^fxos_cover_oam, #!fxos_cover_oam, #$04)
  bra fxos_cover_done
fxos_hide_cover:
  sep #$20 : .as
  lda #$00
  cmp fxos_cover_visible
  beq fxos_cover_done
  sta fxos_cover_visible
  ldx #$0040
  stx $2102
  DMA7(#$00, #140, #^fxos_cover_hidden, #!fxos_cover_hidden, #$04)
fxos_cover_done:
  plp
  rts

#include "fxpakos_cover.i65"
